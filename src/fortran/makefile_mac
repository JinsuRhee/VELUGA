# Makefile for building a shared library (dylib) from Fortran and C code for VELUGA
# 	--- For M-series MacOS
#

# Conda dependence
CONDA_INC = $(CONDA_PREFIX)/include
CONDA_LIB = $(CONDA_PREFIX)/lib

# Source Files
BASES	= find_domain jsrd_part_totnum jsrd_part get_ptcl prop_time jsamr2cell_totnum jsamr2cell rv_match prop_sfr js_kde_2dhisto js_kde_gauss_binning js_kde_gauss_pts js_gasmap get_hash get_merit get_merit2 js_indmatch get_contam js_getpt_ft js_vmap

BASES_conly = save_cat read_cat

F90_SRCS	= $(BASES:=.f90)
F90_OBJS	= $(BASES:=.o)
C_SRCS		= $(BASES:=_c2f.c)
C_OBJS		= $(BASES:=_c2f.o)
DYLIBS		= $(BASES:=.so)

C_SRCS_CONLY	= $(BASES_conly:=_conly.c)
DYLIBS_CONLY	= $(BASES_conly:%=%_conly.so)

# Compilers
FC = $(CONDA_PREFIX)/bin/gfortran
CC = $(CONDA_PREFIX)/bin/gcc
H5CC = $(CONDA_PREFIX)/bin/h5cc

# Flags
ARCH = -arch x86_64
PIC  = -fPIC
OMP  = -fopenmp
CLANG = -Xclang
LMEM = -mcmodel=large
NORANGE = -fno-range-check

# Compiles
all: ckdtree $(DYLIBS) $(DYLIBS_CONLY)

ckdtree:
	$(FC) $(OMP) $(PIC) $(ARCH) -I$(CONDA_INC) -c js_kdtree.f90 -o js_kdtree.o

%.o: %.f90
	$(FC) $(OMP) $(PIC) $(ARCH) $(NORANGE) -I$(CONDA_INC) -c $< -o $@

%_c2f.o: %_c2f.c
	$(CC) $(CLANG) $(OMP) $(PIC) $(ARCH) -I$(CONDA_INC) -c $< -o $@

%.so: %.o %_c2f.o
	$(FC) -dynamiclib $(OMP) $(ARCH) -L$(CONDA_LIB) -lomp $^ js_kdtree.o -o $@ -lgfortran

%_conly.so: %_conly.c
	$(CC) $(CLANG) $(OMP) $(PIC) $(ARCH) -I$(CONDA_INC) -L$(CONDA_LIB) -lhdf5 $< -o $@

clean:
	rm -f *.o *.so

.PHONY: all clean
